      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (algorithm) (rate(beautyrec_recommendations_total[$__rate_interval]))",
          "legendFormat": "{{algorithm}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, algorithm) (rate(beautyrec_recommendation_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{algorithm}} p95 latency",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Recommendation Quality (Throughput & p95 Latency by Algorithm)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Population Stability Index per feature and KS-test p-value for prediction distribution. PSI > 0.25 indicates significant drift; KS p < 0.05 indicates distribution shift",
